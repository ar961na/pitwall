# Based on ~/Work/references/python/gitignore, plus the frontend and project specifics.

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
.venv/
venv/
.python-version

# Tools
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
.ipynb_checkpoints/
backend/tasks.xml

# Secrets
.env
.env.*
!.env.example
*.pem
*.key

# Data and models are never committed (licensing and size); see docs/REFERENCES.md
data/*
!data/.gitkeep
models/*
!models/.gitkeep
*.csv
*.parquet
*.h5
*.npz
*.pkl
*.joblib
*.pt
*.pth
*.ckpt
*.onnx
checkpoints/
# small, self-made result files that are meant to be versioned
!predictions/*.csv
!predictions/*.json

# Experiment tracking
mlruns/
mlartifacts/
mlflow.db
wandb/
outputs/
logs/

# Frontend
node_modules/
frontend/dist/
frontend/public/static-api/
*.tsbuildinfo

# OS and editors
.DS_Store
.idea/
.vscode/
*.swp
.claude/settings.local.json
